# ---------------------------------------------------------------------------
# Archives and site backups.
# GitHub hard-rejects any file over 100MB, which is what blocked the push:
# css.zip was 646MB and sachdevagroup-beta-.rar 112MB. These are backups of the
# site, not source — they belong in a drive or a release, never in the repo.
# ---------------------------------------------------------------------------
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.bak

# working backups this project keeps on disk
_backup_pages/
*.prev.html
*.pre-*.html

# scratch files from tooling
_sgtest*.html
_icon-*.html
_t-*.html
_t-css/
*.js.bak

# local server / editor noise
.DS_Store
Thumbs.db
*.log

# Claude Code local tooling (preview server config, worktrees)
.claude/

# throwaway motion test harness

# throwaway browser test harness (regenerate with the tools in git history)
_mtest.html
_mtest/
_itest-*.html
tools-*.js

# ---------------------------------------------------------------------------
# Live mail credentials. mail-config.php holds a Gmail app password, which
# grants full send rights on that account — committing it publishes it.
# mail-config.sample.php is the version that belongs in the repo; copy it and
# fill the copy in. Never remove this line.
# ---------------------------------------------------------------------------
mail-config.php

# ---------------------------------------------------------------------------
# CMS runtime state (admin panel).
# data/ holds the SQLite database: every administrator password hash and every
# note a visitor has sent. It is per-installation, never source.
# config.local.php is where a MySQL password goes if the site is ever moved
# off SQLite — the same reason mail-config.php is excluded above.
# ---------------------------------------------------------------------------
data/
includes/config.local.php
